# ─── Email (Resend) ───────────────────────────────────────────────
# Used by catering / tray / careers / contact / newsletter handlers.
RESEND_API_KEY=
# Default inbox for submissions + fallback for any unset per-form address.
CONTACT_TO_EMAIL=hello@hallowedgroundscoffeeco.com
# Verified sending address on your Resend domain.
CONTACT_FROM_EMAIL=website@hallowedgroundscoffeeco.com

# Per-form routing (each falls back to CONTACT_TO_EMAIL if blank).
CATERING_TO_EMAIL=
KYLE_EMAIL=               # also receives in-store TRAY orders
HIRING_TO_EMAIL=

# Send a friendly confirmation email back to the submitter (catering/tray/careers).
SEND_AUTORESPONDER=false

# ─── Supabase ─────────────────────────────────────────────────────
# Public anon key — safe in the browser, gated by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — SERVER ONLY. Never prefix with NEXT_PUBLIC. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
